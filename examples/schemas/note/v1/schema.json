{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "ts", "facets", "d"],
  "properties": {
    "type": {"type": "string", "enum": ["note"]},
    "ts": {"type": "string", "format": "date-time"},
    "facets": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "d": {"type": "object", "additionalProperties": false, "required": ["note"], "properties": {"note": {"type": "string", "minLength": 1}}}
  }
}
